// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum IpoStatus {
  UPCOMING
  OPEN
  CLOSED
  LISTED
}

enum IpoBoard {
  MAINBOARD
  SME
}

enum ConfidenceTier {
  HIGH
  MEDIUM
  LOW
}

enum AlertChannel {
  EMAIL
}

enum AlertTrigger {
  OPEN
  CLOSING
  ALLOTMENT
  LISTING
}

enum ReminderStatus {
  SENT
  FAILED
}

enum PublicationState {
  DRAFT
  PUBLISHED
  REJECTED
  QUARANTINED
}

enum OfficialVerificationDecision {
  AUTO_PUBLISH
  RETRY
  EXCEPTION
}

enum OfficialFieldStatus {
  MATCH
  CONFLICT
  MISSING_OFFICIAL
}

enum OfficialIncidentKind {
  CONFLICT
  PUBLISHED_DRIFT
}

enum OfficialIncidentStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum IpoFilingStage {
  DRHP_FILED
  RHP_FILED
}

// ---------- core IPO data ----------

model Company {
  id        String   @id @default(uuid())
  name      String
  sector    String?
  ipos      Ipo[]
  createdAt DateTime @default(now())
}

// Failed source fetches live outside Ipo because a complete/valid IPO row does
// not exist yet. New candidates are always attempted before due retries; this
// prevents one broken upstream page from starving the rest of the market.
model DiscoveryAttempt {
  id            String   @id @default(uuid())
  sourceUrl     String   @unique
  companyName   String
  attempts      Int      @default(0)
  lastAttemptAt DateTime
  nextAttemptAt DateTime
  lastError     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt, attempts])
}

model Ipo {
  id            String    @id @default(uuid())
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     String
  status        IpoStatus
  board         IpoBoard
  priceBandLow  Decimal?
  priceBandHigh Decimal?
  lotSize       Int?
  issueSizeCr   Decimal?
  freshIssueCr  Decimal?
  ofsCr         Decimal?
  openDate      DateTime?
  closeDate     DateTime?
  allotmentDate DateTime?
  refundDate    DateTime?
  listingDate   DateTime?
  listingPrice  Decimal?
  registrar     String?
  leadManagers  String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Discovery pipeline: PUBLISHED here can mean either a human approved
  // it (reviewedBy set) or it cleared every auto-publish rule on its own
  // (reviewedBy null, autoPublished true) — see CorrectionLog for the
  // full publish/reject/auto-publish audit trail. QUARANTINED candidates
  // failed validation or source agreement and are kept (not silently
  // discarded) so a human can see exactly why.
  publicationState      PublicationState @default(DRAFT)
  discoveredFrom        String[]         @default([]) // e.g. ["ipowatch", "sahi"] — which sources found this candidate
  discoveredAt          DateTime?
  reviewedBy            String?
  reviewedAt            DateTime?
  autoPublished         Boolean          @default(false)
  quarantineReason      String? // why validation/confidence checks failed
  officialCheckAttempts Int              @default(0)
  officialNextAttemptAt DateTime?
  officialLastAttemptAt DateTime?
  officialLastSuccessAt DateTime?
  drhpUrl               String?
  rhpUrl                String?
  sourceUrl             String? // the exact discovery detail-page URL — reconstructing it from the
  // company name later (e.g. for reclassification) is a guess that fails on
  // multi-word/punctuated names; storing it once avoids ever needing to guess.

  documents             Document[]
  gmpObservations       GmpObservation[]
  gmpSnapshots          GmpSnapshot[]
  subscriptionSnapshots SubscriptionSnapshot[]

  // New production financial pipeline
  financialDocuments  FinancialDocument[]  @relation("FinancialDocuments")
  publishedFinancials FinancialPublished[] @relation("PublishedFinancials")

  // Legacy (to be deprecated after migration)
  financialSnapshots FinancialSnapshot[]

  watchlistItems     WatchlistItem[]
  alertSubscriptions AlertSubscription[]
  reminderDeliveries ReminderDelivery[]
  officialEvidence   OfficialEvidenceCapture[]
  officialIncidents  OfficialEvidenceIncident[]
  filingCatalogue    IpoFilingCatalogue[]

  @@index([status])
  @@index([publicationState])
  @@index([publicationState, officialNextAttemptAt])
  @@index([officialLastSuccessAt])
}

// Official filing coverage is intentionally separate from `Ipo`. A DRHP is
// proof that an issue exists, but it often has no final dates, price band, lot
// size, or even an exchange board yet. Keeping it here lets the public product
// show the full pipeline without inventing application-ready terms.
model IpoFilingCatalogue {
  id          String         @id @default(uuid())
  issuerKey   String
  companyName String
  stage       IpoFilingStage
  filingDate  DateTime
  source      String
  sourceUrl   String         @unique
  documentUrl String?
  raw         Json
  ipo         Ipo?           @relation(fields: [ipoId], references: [id], onDelete: SetNull)
  ipoId       String?
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([issuerKey, filingDate])
  @@index([stage, filingDate])
  @@index([ipoId])
}

// Append-only capture of the official payload and the exact decision it
// produced. Rechecks insert another capture rather than rewriting history.
model OfficialEvidenceCapture {
  id         String                       @id @default(uuid())
  ipo        Ipo                          @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId      String
  source     String
  sourceUrl  String
  capturedAt DateTime
  decision   OfficialVerificationDecision
  reasons    String[]
  raw        Json
  createdAt  DateTime                     @default(now())

  comparisons OfficialFieldComparison[]

  @@index([ipoId, capturedAt])
  @@index([decision, capturedAt])
}

model OfficialFieldComparison {
  id             String                  @id @default(uuid())
  capture        OfficialEvidenceCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  captureId      String
  field          String
  status         OfficialFieldStatus
  candidateValue String?
  officialValue  String?
  sourceUrl      String?
  createdAt      DateTime                @default(now())

  @@index([captureId, field])
}

// Operator-facing projection of repeated official-source conflicts. Raw
// evidence remains append-only in OfficialEvidenceCapture; this table prevents
// the same unchanged conflict from becoming dozens of separate admin tasks.
model OfficialEvidenceIncident {
  id              String                 @id @default(uuid())
  ipo             Ipo                    @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId           String
  fingerprint     String                 @unique
  kind            OfficialIncidentKind
  status          OfficialIncidentStatus @default(OPEN)
  source          String
  fields          String[]
  reasons         String[]
  occurrenceCount Int                    @default(1)
  firstSeenAt     DateTime               @default(now())
  lastSeenAt      DateTime               @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, kind, lastSeenAt])
  @@index([ipoId, status])
}

model Document {
  id      String @id @default(uuid())
  ipo     Ipo    @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId   String
  label   String
  url     String
  docType String // rhp | drhp | anchor

  @@index([ipoId])
}

// ---------- GMP: multi-source, fallback, provenance ----------

model GmpSource {
  id           String           @id @default(uuid())
  name         String           @unique
  baseUrl      String
  adapterKey   String           @unique
  active       Boolean          @default(true)
  observations GmpObservation[]
  health       SourceHealth?
  createdAt    DateTime         @default(now())
}

model GmpObservation {
  id           String    @id @default(uuid())
  ipo          Ipo       @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId        String
  source       GmpSource @relation(fields: [sourceId], references: [id])
  sourceId     String
  value        Decimal?
  success      Boolean
  errorMessage String?
  capturedAt   DateTime  @default(now())

  @@index([ipoId, capturedAt])
  @@index([sourceId, capturedAt])
}

model GmpSnapshot {
  id           String         @id @default(uuid())
  ipo          Ipo            @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId        String
  medianValue  Decimal
  sourceCount  Int
  maxDeviation Decimal
  confidence   ConfidenceTier
  capturedAt   DateTime       @default(now())

  @@index([ipoId, capturedAt])
}

model SourceHealth {
  id                  String    @id @default(uuid())
  source              GmpSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId            String    @unique
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  degraded            Boolean   @default(false)
}

// Health for all non-GMP operations: official catalogues/details, discovery,
// subscriptions and filing downloads. GMP retains SourceHealth because it is
// naturally keyed by GmpSource; the admin dashboard reads both contracts.
model SourceOperationHealth {
  key                 String    @id
  source              String
  operation           String
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  nextRetryAt         DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([source, operation])
  @@index([nextRetryAt])
}

// ---------- subscription (single primary source + exchange fallback) ----------

model SubscriptionSnapshot {
  id             String   @id @default(uuid())
  ipo            Ipo      @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId          String
  qibX           Decimal?
  niiX           Decimal?
  retailX        Decimal?
  employeeX      Decimal?
  sourceExchange String // "nse" | "bse"
  capturedAt     DateTime @default(now())

  @@index([ipoId, capturedAt])
}

// ---------- financials: production-grade verification pipeline ----------

enum FinancialDocumentType {
  DRHP
  RHP
  PROSPECTUS
  CORRIGENDUM
  ADDENDUM
}

enum ExtractionStatus {
  EXTRACTED
  NORMALIZED
  VALIDATION_PASSED
  VALIDATION_FAILED
  OCR_FALLBACK
}

enum FinancialRevisionState {
  EXTRACTED // raw extraction done
  NORMALIZED // units/scope normalized
  VALIDATED // deterministic rules passed or identified issues
  AUTO_VERIFIED // high-confidence, no human intervention needed
  REVIEW_REQUIRED // extraction issues, ambiguity, or mismatch detected
  APPROVED // human approved
  PUBLISHED // in production, immutable
  SUPERSEDED // newer document/revision published
  REVOKED // found to be incorrect
}

enum FinancialMetric {
  REVENUE
  PAT
  EPS
  EBITDA
  ASSETS
  NET_WORTH
  BORROWINGS
}

model FinancialDocument {
  id              String                @id @default(uuid())
  ipo             Ipo                   @relation("FinancialDocuments", fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId           String
  documentType    FinancialDocumentType
  sourceUrl       String // official SEBI/NSE/BSE link
  sourceHost      String // sebi.gov.in | nseindia.com | bseindia.com
  fetchedAt       DateTime
  sha256          String // immutable checksum for audit
  pageCount       Int?
  ocrRequired     Boolean               @default(false)
  ocrModel        String? // which OCR version was used
  publicationDate DateTime? // document publication date (not fetch date)
  isLatestForType Boolean               @default(true) // helps select precedence when multiple RHPs exist

  extractions FinancialExtraction[]
  createdAt   DateTime              @default(now())

  @@unique([sha256])
  @@index([ipoId, documentType])
  @@index([sourceUrl])
}

model FinancialExtraction {
  id                   String            @id @default(uuid())
  document             FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId           String
  metric               FinancialMetric
  originalLabel        String // exact text as printed in source
  rawValue             String // before normalization
  normalizedValue      Decimal? // parsed, unit-converted
  currency             String            @default("INR")
  unit                 String            @default("Cr") // Cr | Mn | actual number
  fiscalYear           String // e.g. "31 Mar 2026"
  fiscalYearStart      DateTime?
  fiscalYearEnd        DateTime?
  scope                String            @default("Consolidated") // Consolidated | Standalone
  auditStatus          String            @default("Audited") // Audited | Restated | Provisional
  pageNumber           Int?
  tableReference       String? // "Table 5.2" or similar
  extractionStatus     ExtractionStatus  @default(EXTRACTED)
  extractionConfidence Float // 0.0 to 1.0
  ocrUsed              Boolean           @default(false)
  ocrConfidence        Float? // non-null only if ocrUsed
  validationIssues     String[] // array of flagged problems
  createdAt            DateTime          @default(now())

  revisions FinancialRevision[] @relation("ExtractionRevisions")

  @@index([documentId, metric])
  @@index([fiscalYear])
}

model FinancialRevision {
  id           String                 @id @default(uuid())
  extraction   FinancialExtraction    @relation("ExtractionRevisions", fields: [extractionId], references: [id], onDelete: Cascade)
  extractionId String
  state        FinancialRevisionState @default(EXTRACTED)

  // Comparison to existing snapshot (if any)
  existingValue   Decimal?
  existingSource  String?
  mismatchPercent Float?

  // Validation decision
  validationPass  Boolean?
  validationNotes String?

  // Review decision
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewDecision String? // "approved" | "rejected_reason"
  reviewNotes    String?

  // Published reference (if applicable)
  publishedId String?
  published   FinancialPublished? @relation(fields: [publishedId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, extractionId])
}

model FinancialPublished {
  id         String          @id @default(uuid())
  ipo        Ipo             @relation("PublishedFinancials", fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId      String
  metric     FinancialMetric
  value      Decimal
  fiscalYear String

  // Source audit trail
  sourceDocument   String // DRHP | RHP | PROSPECTUS (type)
  sourceUrl        String
  pageNumber       Int?
  extractionDate   DateTime
  verificationDate DateTime
  approvedBy       String?

  // Versioning
  revisionNumber Int     @default(1)
  supersededBy   String? // ID of newer published record if this is outdated
  revokedReason  String?

  // Immutable record
  publishedAt DateTime @default(now())

  revisions FinancialRevision[]

  @@unique([ipoId, metric, fiscalYear, revisionNumber])
  @@index([ipoId, metric])
}

// Legacy: deprecated in favour of FinancialPublished, kept for transition
model FinancialSnapshot {
  id         String    @id @default(uuid())
  ipo        Ipo       @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId      String
  fiscalYear String
  revenueCr  Decimal?
  patCr      Decimal?
  peRatio    Decimal?
  ronwPct    Decimal?
  debtEquity Decimal?
  eps        Decimal?
  source     String?
  verified   Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ipoId])
}

// ---------- correction audit trail ----------

model CorrectionLog {
  id          String   @id @default(uuid())
  entityType  String // e.g. "FinancialSnapshot"
  entityId    String
  action      String // e.g. "verify", "correct"
  fieldName   String? // which field, if a single-field correction
  oldValue    String?
  newValue    String?
  performedBy String
  note        String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- auth.js tables ----------

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts           Account[]
  sessions           Session[]
  watchlistItems     WatchlistItem[]
  alertSubscriptions AlertSubscription[]
  reminderDeliveries ReminderDelivery[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- watchlist / reminders ----------

model WatchlistItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  ipo       Ipo      @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId     String
  createdAt DateTime @default(now())

  @@unique([userId, ipoId])
}

model AlertSubscription {
  id        String       @id @default(uuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  ipo       Ipo          @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId     String
  channel   AlertChannel @default(EMAIL)
  trigger   AlertTrigger
  createdAt DateTime     @default(now())

  @@unique([userId, ipoId, trigger])
}

// One row per (user, ipo, transition) ever — the unique constraint is
// the actual dedup guarantee: even if the cron somehow ran twice for
// the same transition, a second attempt sees the existing SENT row and
// skips instead of double-emailing. FAILED rows are retried on the next
// cycle rather than silently dropped.
model ReminderDelivery {
  id         String         @id @default(uuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  ipo        Ipo            @relation(fields: [ipoId], references: [id], onDelete: Cascade)
  ipoId      String
  transition String // e.g. "UPCOMING->OPEN"
  status     ReminderStatus
  attempts   Int            @default(1)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, ipoId, transition])
  @@index([status])
}

// ---------- cron reliability ----------

// A single well-known row acts as a mutex: acquiring the lock is one
// conditional UPDATE (only succeeds if unlocked or stale), which is
// atomic in Postgres without needing separate distributed-lock infra.
// A `runningSince` older than the staleness threshold is treated as
// abandoned (e.g. a crashed run that never released it) and can be
// re-acquired rather than blocking the pipeline forever.
model IngestionLock {
  id           String    @id @default("singleton")
  runningSince DateTime?
  startedBy    String?
}

model IngestionRun {
  id               String    @id @default(uuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  ok               Boolean
  skippedDueToLock Boolean   @default(false)
  summary          Json?
  error            String?

  @@index([startedAt])
}

model DigestDelivery {
  id         String         @id @default(uuid())
  digestDate DateTime
  recipient  String
  status     DeliveryStatus
  attempts   Int            @default(1)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([digestDate, recipient])
  @@index([status, digestDate])
}

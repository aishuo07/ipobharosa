# Public origin. Set both values to the same HTTPS origin in hosted environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Primary database and Auth.js session encryption.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ipobharosa
AUTH_SECRET=replace-with-a-long-random-local-secret

# Google OAuth. Configure callback URLs for the same canonical public origin.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional email sign-in and watchlist reminders. Keep disabled until sender verification is complete.
EMAIL_USER_FEATURES_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Server-only scheduled/admin endpoints. Never expose these through NEXT_PUBLIC variables.
CRON_SECRET=
ADMIN_BEARER_TOKEN=

# Unofficial GMP sources: ipoji, investorgain and ipotrack are owner-approved
# and enabled by default in production. Set this only to override/toggle them.
# IPOWatch and Sahi are hard-disabled by source policy and cannot be enabled here.
GMP_SOURCE_ALLOWLIST=

# Optional: override the API the mobile app reads. Defaults to Production.
EXPO_PUBLIC_API_URL=https://ipobharosa.vercel.app

# Optional: PostHog analytics. Without these the app runs normally but
# captures no events.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Optional: Sentry error + performance monitoring (mobile). Without this the
# app runs normally but captures no errors.
EXPO_PUBLIC_SENTRY_DSN=https://your_dsn@o123456.ingest.sentry.io/123456